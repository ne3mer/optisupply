# Frontend environment variables

# API URLs - Base URL for API requests
# Local development - backend listens on 8080 (see ethicsupply-node-backend/src/server.js)
VITE_API_URL=http://localhost:8080/api
# Production - uncomment this when deploying
# VITE_API_URL=https://optisupply-backend.vercel.app/api

# Feature flags
VITE_ENABLE_MOCK_DATA=false
