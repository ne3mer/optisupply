# Primary API (baked in at build time). Example: your Leapcell backend.
# VITE_API_URL=https://your-backend.example.com/api

# Optional second host tried automatically if primary times out (6s per host).
# VITE_API_FALLBACK_URL=https://optisupply.onrender.com/api

# When true, some endpoints use local mock data if every host fails.
# VITE_ENABLE_MOCK_DATA=false

# If unset, production builds try: VITE_API_URL → VITE_API_FALLBACK_URL → Render default.
